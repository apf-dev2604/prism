#!/usr/bin/env python3
"""Shared, standard-library ETL failure notification; Python 3.9+.
Usage: python shared_functions/etl_alert.py --stage DLAKE-NEXUS --entity gameTransaction
  --window-from 2024-11-01 --window-to 2024-11-02 --error-log path --exit-code 1
Best-effort SMTP only. Does not touch databases, alter DQ results, or retry work.
"""
import argparse
import os
import smtplib
import socket
import getpass
import re
from datetime import datetime, timezone
from email.message import EmailMessage
from pathlib import Path


def recovery_guidance(stage, entity, window_from, window_to, raw_log):
    """Advisory only: never executes recovery or declares a DQ pass."""
    markers = re.findall(r"\[STRICT PHASE\] phase=([A-Z_]+)", raw_log)
    # FAILED is a final exception marker, not the phase that failed.
    phase = next((item for item in reversed(markers) if item != "FAILED"), "UNKNOWN")
    root = "/home/allanf/scripts/nexus_etl_prod/dlake_psql-nexus_psql"
    cmd = f"bash run_nexus_imp.sh {window_from} {window_to} {entity}"
    guidance = ["FAILURE PHASE: " + phase, "", "INVESTIGATION (read-only):",
        f"cd {root}",
        "Check prior errors, the delivery-control state and current database user.",
        "Inspect staging count, expected source count, keys, latest DQ result and production overlap.",
        "Use the approved SQL in sql/03_resume_readonly_checks.sql.",
        "DO NOT delete staging or reset delivery state simply to clear this alert.", ""]
    if stage != "DLAKE-NEXUS":
        guidance.append("RECOVERY: Follow this stage's approved runbook; no generic automatic replay.")
    elif phase == "STAGING":
        guidance += ["AFTER VERIFICATION (manual):", cmd + " --resume-from staging",
            "Only if staging belongs to this window and its unique-key/idempotency constraints are verified.",
            "This replays the full source window; it is NOT a checkpoint seek."]
    elif phase in ("DQ", "STAGING_CHECK"):
        guidance += ["AFTER VERIFICATION (manual):", cmd + " --resume-from dq",
            "First fix DQ infrastructure/schema errors; verify staging complete and no material DQ mismatch.",
            "For an incomplete stage, use an approved staging recovery instead.",
            "The current package does not support wallet DQ-only resume."]
    elif phase in ("PUBLISH", "PUBLISH_PRECHECK"):
        guidance += ["AFTER VERIFICATION (manual):", cmd + " --resume-from publish",
            "ONLY if the control record still has PASS and a valid approved dq_run_id,",
            "and publication has not already committed. Check production rows and conflicts first.",
            "Never interpret a connection error as proof that publishing rolled back."]
    else:
        guidance += ["RECOVERY COMMAND: NOT DETERMINED", 
            "Review the traceback and control record. Do not retry blindly."]
    return guidance


def send_failure(stage, entity, window_from, window_to, exit_code, error_log=""):

    # Reuse the existing migration recipient, while preserving an explicit DQ override.
    raw_recipients = os.getenv("DQ_ALERT_TO", "").strip() or os.getenv("MIGRATION_REPORT_TO", "").strip()
    recipients = [address.strip() for address in raw_recipients.replace(";", ",").split(",") if address.strip()]
    host = os.getenv("SMTP_HOST", "")
    user = os.getenv("SMTP_USER", "")
    password = os.getenv("SMTP_PASSWORD", "")
    sender = os.getenv("SMTP_FROM", user)
    if not recipients or not host or not sender:
        print("[SHARED ALERT][SKIP] Missing recipient (DQ_ALERT_TO or MIGRATION_REPORT_TO), SMTP_HOST or SMTP_FROM", flush=True)
        return False
    lines = ""
    if error_log:
        try:
            lines = "\n".join(Path(error_log).read_text(errors="replace").splitlines()[-45:])[-9000:]
        except OSError as exc:
            lines = "Cannot read error log: " + str(exc)
    msg = EmailMessage()
    msg["From"] = sender
    msg["To"] = ", ".join(recipients)
    msg["Subject"] = f"[CRITICAL][ETL][{stage}] {entity} exit={exit_code}"
    msg.set_content("\n".join([
        "ETL process failed; manual investigation required.",
        f"UTC time: {datetime.now(timezone.utc).isoformat()}",
        f"Host: {socket.gethostname()}",
        f"OS user: {getpass.getuser()}",
        f"Stage: {stage}", f"Entity: {entity}",
        f"Window: {window_from} to {window_to}",
        f"Process exit code: {exit_code}",
        "DQ status: UNKNOWN / NOT CONFIRMED",
        "NEXUS release status: NOT CONFIRMED; verify audit and committed rows.",
        "Database user: inspect connection diagnostic logs or run SELECT current_user using the ETL credentials.",
        "", *recovery_guidance(stage, entity, window_from, window_to, lines),
        "", "Last log lines:", lines,
    ]))
    try:
        port = int(os.getenv("SMTP_PORT", "587"))
        mode = os.getenv("SMTP_SECURITY", "starttls").lower()
        if mode == "ssl":
            client = smtplib.SMTP_SSL(host, port, timeout=30)
        else:
            client = smtplib.SMTP(host, port, timeout=30)
        with client as smtp:
            if mode == "starttls":
                smtp.starttls()
            elif mode not in ("ssl", "none"):
                raise ValueError("Unsupported SMTP_SECURITY: " + mode)
            if user and password:
                smtp.login(user, password)
            smtp.send_message(msg)
        print("[SHARED ALERT][SENT]", flush=True)
        return True
    except Exception as exc:
        print(f"[SHARED ALERT][ERROR] {type(exc).__name__}: {exc}", flush=True)
        return False


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--stage", required=True)
    p.add_argument("--entity", required=True)
    p.add_argument("--window-from", default="unknown")
    p.add_argument("--window-to", default="unknown")
    p.add_argument("--exit-code", type=int, required=True)
    p.add_argument("--error-log", default="")
    a = p.parse_args()
    send_failure(a.stage, a.entity, a.window_from, a.window_to, a.exit_code, a.error_log)
    # Alert failure must not mask the original job failure exit code.


if __name__ == "__main__":
    main()

